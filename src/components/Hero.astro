---
import { copy, moods, type Lang } from "../i18n/copy";
import { counties, hasHeritage, streets } from "../lib/streets";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const stats = [
  streets.length,
  counties.length,
  streets.filter((s) => s.scores.food >= 3).length,
  streets.filter(hasHeritage).length,
];
---

<section class="hero">
  <p class="kicker" data-reveal>{t.heroKicker}</p>
  <h1 class="h-display title">
    <span class="l1" data-scramble>{t.heroTitle[0]}</span>
    <span class="l2 grad-text">{t.heroTitle[1]}</span>
  </h1>
  <p class="lede" data-reveal style="--d:2">{t.heroLede}</p>

  <div class="moodpad" data-reveal style="--d:3">
    <p class="prompt">{t.moodPrompt}</p>
    <div class="pads" role="radiogroup" aria-label={t.moodPrompt}>
      {
        moods
          .filter((m) => m.id !== "all")
          .map((m, i) => (
            <button type="button" role="radio" aria-checked="false" class="pad" data-mood={m.id} data-magnetic style={`--i:${i}`}>
              <span class="ico" aria-hidden="true">{m.icon}</span>
              <span>{m[lang]}</span>
            </button>
          ))
      }
    </div>
    <a href="#explore" class="btn btn-primary go" data-magnetic>
      <span data-hero-count>{t.explore.results(streets.length)}</span>
      <span aria-hidden="true">↓</span>
    </a>
  </div>

  <dl class="stats">
    {
      stats.map((n, i) => (
        <div data-reveal style={`--d:${i + 4}`}>
          <dt>{t.statsLabel[i]}</dt>
          <dd data-count={n}>{n}</dd>
        </div>
      ))
    }
  </dl>
</section>

<script>
  import { items } from "../scripts/items";
  import { matches, subscribe } from "../scripts/state";
  const label = document.querySelector<HTMLElement>("[data-hero-count]");
  const tpl = document.querySelector<HTMLElement>("[data-count-label]")?.dataset.tpl;
  if (label && tpl) subscribe(() => (label.textContent = tpl.replace("{n}", String(items.filter((i) => matches(i)).length))));
</script>

<style>
  .hero {
    padding: clamp(40px, 9vh, 110px) 0 24px;
  }
  .title {
    margin: 18px 0 18px;
    font-size: clamp(44px, 7vw, 96px);
    display: flex;
    flex-direction: column;
  }
  .l1 {
    color: var(--text);
  }
  :global(html[lang="en"]) .title {
    font-size: clamp(40px, 5.4vw, 76px);
  }
  .l2 {
    filter: drop-shadow(0 0 30px #ff6a3d40);
    animation: rise 1.1s var(--ease-out) 0.35s both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.4em);
      clip-path: inset(0 0 100% 0);
      filter: blur(10px);
    }
  }
  .moodpad {
    margin-top: 34px;
  }
  .prompt {
    margin: 0 0 12px;
    font-size: 14px;
    color: var(--jade);
    letter-spacing: 0.1em;
  }
  .pads {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    max-width: 560px;
  }
  .pad {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 58px;
    padding: 10px 14px;
    border-radius: 16px;
    border: 1px solid var(--line-2);
    background: linear-gradient(160deg, #ffffff0f, #ffffff03);
    cursor: pointer;
    font-size: 15px;
    font-weight: 600;
    text-align: left;
    overflow: hidden;
    transition:
      border-color 0.3s,
      box-shadow 0.3s,
      translate 0.2s var(--ease),
      color 0.3s;
  }
  .pad::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, var(--amber), var(--brick));
    opacity: 0;
    transform: translateY(100%);
    transition:
      opacity 0.35s,
      transform 0.45s var(--ease-out);
  }
  .pad > * {
    position: relative;
  }
  .ico {
    font-size: 20px;
    filter: drop-shadow(0 0 8px #ffb54766);
  }
  .pad:hover {
    border-color: #ffb54788;
    box-shadow: 0 0 28px #ffb54722;
  }
  .pad[aria-checked="true"] {
    color: #160a04;
    border-color: transparent;
    box-shadow: 0 0 36px #ff6a3d66;
  }
  .pad[aria-checked="true"]::before {
    opacity: 1;
    transform: none;
  }
  .go {
    margin-top: 16px;
    min-height: 50px;
    padding: 12px 26px;
    font-size: 16px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 48px 0 0;
    max-width: 620px;
  }
  .stats div {
    border-left: 1px solid var(--line-2);
    padding-left: 12px;
  }
  .stats dt {
    font-size: 12px;
    color: var(--dim);
    order: 2;
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  .stats dd {
    margin: 0;
    font-family: "Space Grotesk Variable", monospace;
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 600;
    color: var(--text);
    text-shadow: 0 0 20px #2fe6c840;
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: 20px;
    }
    .hero .kicker {
      letter-spacing: 0.12em;
      font-size: 11px;
    }
    .pads {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 18px;
    }
  }
</style>
