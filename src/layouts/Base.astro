---
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/noto-sans-tc";
import "@fontsource/noto-serif-tc/900.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Effects from "../components/Effects.astro";
import { copy, type Lang } from "../i18n/copy";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** this page's path in each language */
  paths: { zh: string; en: string };
  image?: string;
  noindex?: boolean;
}
const { lang, paths, image, noindex = false } = Astro.props;
const t = copy[lang];
const title = Astro.props.title ?? t.title;
const description = Astro.props.description ?? t.description;
const site = Astro.site;
const abs = (p: string) => (site ? new URL(p, site).href : p);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06070c" />
    <meta name="color-scheme" content="dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={abs(paths[lang])} />
    <link rel="alternate" hreflang="zh-Hant-TW" href={abs(paths.zh)} />
    <link rel="alternate" hreflang="en" href={abs(paths.en)} />
    <link rel="alternate" hreflang="x-default" href={abs(paths.zh)} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={abs(paths[lang])} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta property="og:locale" content={lang === "zh" ? "zh_TW" : "en_US"} />
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{lang === "zh" ? "跳到主要內容" : "Skip to content"}</a>
    <div class="atmo" aria-hidden="true"></div>
    <div class="cursor-light" aria-hidden="true"></div>
    <Header lang={lang} paths={paths} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <Effects />
  </body>
</html>
