---
import { base, copy, type Lang } from "../i18n/copy";
interface Props {
  lang: Lang;
  paths: { zh: string; en: string };
}
const { lang, paths } = Astro.props;
const t = copy[lang];
const home = base(lang);
const other = lang === "zh" ? "en" : "zh";
---

<header class="hdr" data-hdr>
  <div class="hdr-in">
    <a class="logo" href={home} aria-label={t.title}>
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <path d="M14 46V26l18-10 18 10v20" />
        <path class="j" d="M24 46V34h16v12" />
        <circle cx="32" cy="26" r="3.5" />
      </svg>
      <span class="logo-zh">老街時光機</span>
      <span class="logo-en">OLD STREET · TW</span>
    </a>
    <nav aria-label={lang === "zh" ? "主選單" : "Main"}>
      <a href={`${home}#explore`}>{t.nav.explore}</a>
      <a href={`${home}#method`}>{t.nav.method}</a>
      <a class="lang" href={paths[other]} hreflang={other === "zh" ? "zh-Hant-TW" : "en"} lang={other === "zh" ? "zh-Hant-TW" : "en"}>
        {t.langSwitch}
      </a>
    </nav>
  </div>
</header>

<script>
  const hdr = document.querySelector<HTMLElement>("[data-hdr]");
  const onScroll = () => hdr?.classList.toggle("scrolled", scrollY > 8);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 14px var(--gutter);
    transition: background 0.3s, border-color 0.3s, backdrop-filter 0.3s;
    border-bottom: 1px solid transparent;
    view-transition-name: site-header;
  }
  .hdr:global(.scrolled) {
    background: #06070cb8;
    backdrop-filter: blur(16px) saturate(1.4);
    border-bottom-color: var(--line);
  }
  .hdr-in {
    max-width: var(--max);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .logo {
    display: grid;
    grid-template-columns: 36px auto;
    column-gap: 10px;
    align-items: center;
    line-height: 1.1;
  }
  .logo svg {
    grid-row: span 2;
    width: 36px;
    height: 36px;
    fill: none;
    stroke: var(--brick);
    stroke-width: 4;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 6px #ff6a3d88);
  }
  .logo svg .j {
    stroke: var(--jade);
  }
  .logo svg circle {
    fill: var(--amber);
    stroke: none;
  }
  .logo-zh {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: 17px;
    letter-spacing: 0.08em;
  }
  .logo-en {
    font-family: "Space Grotesk Variable", monospace;
    font-size: 10px;
    letter-spacing: 0.28em;
    color: var(--dim);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  nav a {
    padding: 10px 14px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    color: var(--muted);
    font-size: 15px;
    transition: color 0.2s, background 0.2s;
  }
  nav a:hover {
    color: var(--text);
    background: #ffffff0d;
  }
  nav .lang {
    border: 1px solid var(--line-2);
    margin-left: 6px;
    font-family: "Space Grotesk Variable", sans-serif;
    font-weight: 600;
    color: var(--text);
  }
  @media (max-width: 640px) {
    nav a:not(.lang) {
      display: none;
    }
    .logo-en {
      display: none;
    }
    .logo {
      grid-template-columns: 32px auto;
    }
  }
</style>
